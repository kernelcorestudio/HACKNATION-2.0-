# Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub Credentials
# Obtain from: https://dataspace.copernicus.eu/ (User Dashboard -> API keys)
# Copy this file to .env and fill in your credentials. NEVER commit .env to version control!

SH_CLIENT_ID=your-copernicus-client-id-here
SH_CLIENT_SECRET=your-copernicus-client-secret-here

# Sentinel Hub CDSE Endpoints
SH_BASE_URL=https://sh.dataspace.copernicus.eu
SH_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# NETRA Blockchain Provenance Settings (Polygon Amoy Testnet, Chain ID 80002)
POLYGON_AMOY_RPC=https://polygon-amoy.drpc.org
POLYGON_CHAIN_ID=80002
CONTRACT_ADDRESS=0x49Eb908303f4902e8c3dB7b75623E14B2Fb566Da
POLYGON_WALLET_ADDRESS=your-polygon-wallet-address-here
POLYGON_PRIVATE_KEY=your-polygon-private-key-here
POLYGONSCAN_BASE_URL=https://amoy.polygonscan.com
